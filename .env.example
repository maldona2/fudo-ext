# Copiar a .env (no se commitea) o definir como variables de entorno.
# También se aceptan los nombres API_KEY y API_SECRET.
FUDO_API_KEY=
FUDO_API_SECRET=
# Opcionales
FUDO_API_URL=https://api.fu.do/v1alpha1
FUDO_AUTH_URL=https://auth.fu.do/api
# Telegram (resumen diario)
TELEGRAM_BOT_TOKEN=
# Uno o varios chat_id separados por coma (ver: daily_summary.py --chats)
TELEGRAM_CHAT_ID=
