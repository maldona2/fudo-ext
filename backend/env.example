PORT=5001
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5433/mydb
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# FUDO API (read-only use). Required.
FUDO_API_KEY=
FUDO_API_SECRET=

# Public URL of the app, used in alert links (defaults to FRONTEND_URL).
APP_URL=

# Shortage alerts by Telegram (optional). Several chats: comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# First deploy only: creates the owner user when the users table is empty.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=
